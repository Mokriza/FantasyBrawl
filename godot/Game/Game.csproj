<Project Sdk="Godot.NET.Sdk/4.7.2">

  <!-- The Godot client. The rules live in Brawl.Core; this is only what is on screen. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Brawl.Game</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Brawl.Core\Brawl.Core.csproj" />
  </ItemGroup>

  <!--
    The content is the same JSON the web game reads, in src/content. It is copied into
    the Godot project (res://content) so an export carries it; the copy is not committed.
  -->
  <Target Name="CopyContent" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <ContentJson Include="..\..\src\content\**\*.json" />
    </ItemGroup>
    <Copy SourceFiles="@(ContentJson)" DestinationFiles="@(ContentJson->'content\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <!--
    How abilities look and sound is the web game's src/ui/assets/vfx.json, and the sounds
    it names are the web game's recordings: both are copied in the same way.
  -->
  <Target Name="CopyVfx" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <VfxJson Include="..\..\src\ui\assets\vfx.json" />
      <Recordings Include="..\..\public\assets\ninja-adventure\sounds\*.wav" />
    </ItemGroup>
    <Copy SourceFiles="@(VfxJson)" DestinationFolder="content" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(Recordings)" DestinationFolder="content\sounds" SkipUnchangedFiles="true" />
  </Target>

</Project>
